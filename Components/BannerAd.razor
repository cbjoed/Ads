@namespace AdsApp.Components

<div class="banner-ad-container">
    <div class="banner-ad-inner">
        <div class="ad-slot" id="ad-slot-top">
            <!-- Ad network code will be injected here -->
            <div class="ad-placeholder">
                <p>Advertisement</p>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load ad network script (e.g., Google AdSense)
            // await JS.InvokeVoidAsync("adInterop.loadAdScript", "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-xxxxxxxxxxxxxxxx");
        }
        await base.OnAfterRenderAsync(firstRender);
    }
}

<style>
.banner-ad-container {
    width: 100%;
    background: #f0f0f0;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 1rem;
    margin: 1rem 0;
    text-align: center;
}

.banner-ad-inner {
    min-height: 250px;
}

.ad-placeholder {
    background: linear-gradient(135deg, #e0e0e0 0%, #f5f5f5 100%);
    border: 2px dashed #999;
    border-radius: 4px;
    padding: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 250px;
    color: #666;
    font-size: 0.9rem;
}

@@media (max-width: 768px) {
    .ad-placeholder {
        min-height: 150px;
    }

    .banner-ad-inner {
        min-height: 150px;
    }
}
</style>
