@namespace AdsApp.Components

<div class="banner-ad-container">
    <div class="banner-ad-inner">
        <div class="ad-slot" id="ad-slot-top">
            <!-- Ad network code will be injected here -->
            <div class="ad-placeholder">
                <p>Advertisement</p>
            </div>
        </div>
    </div>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Load ad network script (e.g., Google AdSense)
            // await JS.InvokeVoidAsync("adInterop.loadAdScript", "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-xxxxxxxxxxxxxxxx");
        }
        await base.OnAfterRenderAsync(firstRender);
    }
}
