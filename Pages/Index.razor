@page "/"
@using AdsApp.Components
@using AdsApp.Models
@using AdsApp.Services
@inject IJSRuntime JS

<PageTitle>Ads - Study Timer & Task Manager</PageTitle>

<div class="container-fluid">
    <!-- Banner Ad -->
    <BannerAd />

    <!-- Main Content -->
    <div class="row">
        <div class="col-lg-8">
            <!-- Pomodoro Timer Card -->
            <div class="card shadow-lg timer-card">
                <div class="card-body">
                    <h2 class="card-title text-center">🍅 Pomodoro Timer</h2>
                    
                    <div class="timer-display text-center">
                        <div class="time-remaining">
                            @($"{CurrentMinutes:D2}:{CurrentSeconds:D2}")
                        </div>
                    </div>

                    <div class="timer-controls text-center mt-4">
                        @if (!IsRunning)
                        {
                            <button class="btn btn-primary btn-lg" @onclick="StartTimer">
                                ▶ Start
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-warning btn-lg" @onclick="PauseTimer">
                                ⏸ Pause
                            </button>
                        }
                        <button class="btn btn-danger btn-lg ms-2" @onclick="ResetTimer">
                            🔄 Reset
                        </button>
                    </div>

                    <div class="session-stats mt-4">
                        <div class="stat-item">
                            <span class="stat-label">Session Type:</span>
                            <span class="stat-value">@(IsWorkSession ? "Work" : "Break")</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Sessions Completed:</span>
                            <span class="stat-value">@CompletedSessions</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Total Focus Time:</span>
                            <span class="stat-value">@($"{TotalFocusMinutes} min")</span>
                        </div>
                    </div>

                    <!-- Ambient Sound Toggle -->
                    <div class="ambience-section mt-4">
                        <h5>🎵 Ambient Sounds</h5>
                        <div class="btn-group w-100" role="group">
                            <button type="button" class="btn btn-outline-secondary" @onclick="@(() => ToggleAmbience(\"nature\"))">
                                🌿 Nature
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="@(() => ToggleAmbience(\"rain\"))">
                                🌧️ Rain
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="@(() => ToggleAmbience(\"cafe\"))">
                                ☕ Cafe
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="@(() => ToggleAmbience(\"silence\"))">
                                🔇 Silence
                            </button>
                        </div>
                        <small class="d-block mt-2 text-muted">Current: @(AmbientSound == "silence" ? "None" : AmbientSound)</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Task List Card -->
            <div class="card shadow-lg task-card">
                <div class="card-body">
                    <h5 class="card-title">📝 Today's Tasks</h5>

                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="Add a task..." @bind="NewTask" @onkeyup="HandleTaskKeyPress" />
                        <button class="btn btn-outline-primary" type="button" @onclick="AddTask">Add</button>
                    </div>

                    <div class="task-list">
                        @if (Tasks.Count == 0)
                        {
                            <p class="text-muted text-center">No tasks yet. Add one to get started!</p>
                        }
                        else
                        {
                            @foreach (var task in Tasks)
                            {
                                <div class="task-item">
                                    <input type="checkbox" class="form-check-input" @onchange="@((ChangeEventArgs e) => ToggleTask(task, (bool)e.Value!))" checked="@task.Completed" />
                                    <span class="@(task.Completed ? "task-text completed" : "task-text")">@task.Text</span>
                                    <button class="btn btn-sm btn-link text-danger ms-auto" @onclick="() => RemoveTask(task)">✕</button>
                                </div>
                            }
                        }
                    </div>

                    <hr />
                    <small class="text-muted">
                        @Tasks.Count(t => !t.Completed) of @Tasks.Count tasks remaining
                    </small>
                </div>
            </div>

            <!-- Settings Card -->
            <div class="card shadow-lg mt-3">
                <div class="card-body">
                    <h5 class="card-title">⚙️ Settings</h5>
                    
                    <div class="form-group">
                        <label for="work-duration" class="form-label">Work Duration (minutes)</label>
                        <input type="number" class="form-control" id="work-duration" min="1" max="60" @bind="WorkDurationMinutes" @bind:event="onchange" />
                    </div>

                    <div class="form-group">
                        <label for="break-duration" class="form-label">Break Duration (minutes)</label>
                        <input type="number" class="form-control" id="break-duration" min="1" max="30" @bind="BreakDurationMinutes" @bind:event="onchange" />
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="sound-notifications" @bind="SoundNotifications" @bind:event="onchange" />
                        <label class="form-check-label" for="sound-notifications">
                            Sound notifications
                        </label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Banner Ad Bottom -->
    <BannerAd />
</div>

@code {
    private int WorkDurationMinutes = 25;
    private int BreakDurationMinutes = 5;
    private int TotalSeconds = 25 * 60;
    private int RemainingSeconds = 25 * 60;
    private bool IsRunning = false;
    private bool IsWorkSession = true;
    private int CompletedSessions = 0;
    private int TotalFocusMinutes = 0;
    private bool SoundNotifications = true;
    private string AmbientSound = "silence";
    private string NewTask = string.Empty;

    private List<TaskItem> Tasks = new();

    private int CurrentMinutes => RemainingSeconds / 60;
    private int CurrentSeconds => RemainingSeconds % 60;

    protected override async Task OnInitializedAsync()
    {
        // Load settings from localStorage
        var savedSettings = await JS.InvokeAsync<string>("adInterop.getLocalStorageData", "timerSettings");
        if (!string.IsNullOrEmpty(savedSettings))
        {
            try
            {
                var settings = System.Text.Json.JsonSerializer.Deserialize<TimerSettings>(savedSettings);
                if (settings != null)
                {
                    WorkDurationMinutes = settings.WorkDuration;
                    BreakDurationMinutes = settings.BreakDuration;
                    SoundNotifications = settings.SoundNotifications;
                    CompletedSessions = settings.CompletedSessions;
                    TotalFocusMinutes = settings.TotalFocusMinutes;
                }
            }
            catch { }
        }

        // Load tasks from localStorage
        var savedTasks = await JS.InvokeAsync<string>("adInterop.getLocalStorageData", "taskList");
        if (!string.IsNullOrEmpty(savedTasks))
        {
            try
            {
                Tasks = System.Text.Json.JsonSerializer.Deserialize<List<TaskItem>>(savedTasks) ?? new();
            }
            catch { }
        }

        TotalSeconds = WorkDurationMinutes * 60;
        RemainingSeconds = TotalSeconds;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && IsRunning)
        {
            await Task.Delay(1000);
            RemainingSeconds--;
            
            if (RemainingSeconds <= 0)
            {
                await CompleteSession();
            }

            StateHasChanged();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task StartTimer()
    {
        IsRunning = true;
        while (IsRunning && RemainingSeconds > 0)
        {
            await Task.Delay(1000);
            RemainingSeconds--;
            StateHasChanged();

            if (RemainingSeconds == 0)
            {
                await CompleteSession();
                break;
            }
        }
    }

    private void PauseTimer()
    {
        IsRunning = false;
    }

    private void ResetTimer()
    {
        IsRunning = false;
        RemainingSeconds = IsWorkSession ? WorkDurationMinutes * 60 : BreakDurationMinutes * 60;
    }

    private async Task CompleteSession()
    {
        IsRunning = false;
        
        if (SoundNotifications)
        {
            await JS.InvokeVoidAsync("adInterop.playSound", "data:audio/wav;base64,UklGRiYAAABXQVZFZm10IBAAAAABAAEAQB8AAAB9AAACABAAZGF0YQIAAAAAAA==");
        }

        if (IsWorkSession)
        {
            CompletedSessions++;
            TotalFocusMinutes += WorkDurationMinutes;
        }

        IsWorkSession = !IsWorkSession;
        RemainingSeconds = IsWorkSession ? WorkDurationMinutes * 60 : BreakDurationMinutes * 60;
        
        await SaveSettings();
    }

    private void AddTask()
    {
        if (!string.IsNullOrWhiteSpace(NewTask))
        {
            Tasks.Add(new TaskItem { Text = NewTask.Trim(), Completed = false });
            NewTask = string.Empty;
            InvokeAsync(async () => await SaveTasksAsync());
        }
    }

    private void RemoveTask(TaskItem task)
    {
        Tasks.Remove(task);
        InvokeAsync(async () => await SaveTasksAsync());
    }

    private void ToggleTask(TaskItem task, bool completed)
    {
        task.Completed = completed;
        InvokeAsync(async () => await SaveTasksAsync());
    }

    private async Task ToggleAmbience(string sound)
    {
        AmbientSound = sound;
        await JS.InvokeVoidAsync("adInterop.stopAllSounds");
        
        // In a real app, load actual ambient sound files
        // await JS.InvokeVoidAsync("adInterop.playSound", $"sounds/{sound}.mp3", 0.3);
    }

    private async Task SaveSettings()
    {
        var settings = new TimerSettings
        {
            WorkDuration = WorkDurationMinutes,
            BreakDuration = BreakDurationMinutes,
            SoundNotifications = SoundNotifications,
            CompletedSessions = CompletedSessions,
            TotalFocusMinutes = TotalFocusMinutes
        };

        var json = System.Text.Json.JsonSerializer.Serialize(settings);
        await JS.InvokeVoidAsync("adInterop.setLocalStorageData", "timerSettings", json);
    }

    private async Task SaveTasksAsync()
    {
        var json = System.Text.Json.JsonSerializer.Serialize(Tasks);
        await JS.InvokeVoidAsync("adInterop.setLocalStorageData", "taskList", json);
    }

    private async Task HandleTaskKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTask();
        }
    }
}

<style>
.timer-card {
    border: none;
    border-radius: 12px;
    background: white;
}

.timer-display {
    font-size: 4rem;
    font-weight: bold;
    color: #667eea;
    font-family: 'Courier New', monospace;
    margin: 2rem 0;
    letter-spacing: 0.1em;
}

.time-remaining {
    animation: pulse 2s ease-in-out infinite;
}

@@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
}

.timer-controls .btn {
    min-width: 120px;
}

.session-stats {
    background: #f8f9fa;
    padding: 1rem;
    border-radius: 8px;
}

.stat-item {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0;
    border-bottom: 1px solid #e9ecef;
}

.stat-item:last-child {
    border-bottom: none;
}

.stat-label {
    font-weight: 500;
    color: #666;
}

.stat-value {
    font-weight: bold;
    color: #667eea;
}

.ambience-section {
    border-top: 1px solid #e9ecef;
    padding-top: 1rem;
}

.task-card {
    border: none;
    border-radius: 12px;
}

.task-list {
    max-height: 400px;
    overflow-y: auto;
}

.task-item {
    display: flex;
    align-items: center;
    padding: 0.75rem;
    background: #f8f9fa;
    border-radius: 4px;
    margin-bottom: 0.5rem;
    gap: 0.5rem;
}

.task-item input[type="checkbox"] {
    margin-right: 0.5rem;
}

.task-text {
    flex: 1;
    color: #333;
}

.task-text.completed {
    text-decoration: line-through;
    color: #999;
}

.btn-group .btn {
    font-size: 0.85rem;
    padding: 0.5rem 0.75rem;
}
</style>
