@namespace AdsApp.Layout

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ads - Study Timer & Task Manager</title>
    <base href="/" />
    <link href="css/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <link href="css/layout.css" rel="stylesheet" />
    <link href="AdsApp.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />
</head>
<body>
    <header class="navbar navbar-expand-lg navbar-dark bg-gradient">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <span class="brand-icon">🎯</span> Ads - Study Timer
            </a>
        </div>
    </header>

    <main class="page">
        <div class="sidebar">
            <!-- Reserved for future sidebar navigation -->
        </div>

        <div class="content">
            @Body
        </div>
    </main>

    <footer class="bg-light border-top mt-5">
        <div class="container-fluid text-center py-3">
            <small class="text-muted">
                &copy; 2024 Ads. Productivity meets ambient focus.
                <br />
                <a href="/ads.txt" class="text-muted small">ads.txt</a> |
                <a href="https://github.com/yourusername/ads" class="text-muted small" target="_blank">GitHub</a>
            </small>
        </div>
    </footer>

    <script src="js/site.js"></script>
</body>
</html>
